---
import Section from "./Section.astro";
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;

const badgeColors: Record<number, { border: string; text: string }> = {
  0: { border: "border-green", text: "text-green" },
  1: { border: "border-amber", text: "text-amber" },
  2: { border: "border-cyan", text: "text-cyan" },
};
---

<Section text="where i've worked" href="experience">
  <div class="flex flex-col gap-6">
    {
      experience.map(({ company, position, startDate, endDate, summary }, index) => {
        const colors = badgeColors[index] ?? badgeColors[0];
        const companySlug = company.toLowerCase().replace(/\s+/g, "_");
        const positionSlug = position.toLowerCase().replace(/\s+/g, "_");
        const startSlug = startDate.toLowerCase().replace(/\s+/g, "_");
        const endSlug = endDate.toLowerCase().replace(/\s+/g, "_");

        return (
          <div class="border border-border p-6">
            <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <h3 class="text-xl font-bold text-text-primary sm:text-[22px]">
                {companySlug}
              </h3>
              <span class={`inline-block w-fit border ${colors.border} px-2 py-1 font-mono text-[10px] font-medium ${colors.text}`}>
                [{positionSlug}]
              </span>
            </div>
            <p class="mb-4 font-body text-xs text-text-tertiary">
              {startSlug} &gt;&gt; {endSlug}
            </p>
            {Array.isArray(summary) ? (
              <div class="flex flex-col gap-2">
                {summary.map((log) => (
                  <p class="font-body text-[13px] leading-relaxed text-text-secondary">
                    $ {log.toLowerCase()}
                  </p>
                ))}
              </div>
            ) : (
              <p class="font-body text-[13px] leading-relaxed text-text-secondary">
                $ {(summary as string).toLowerCase()}
              </p>
            )}
          </div>
        );
      })
    }
  </div>
</Section>
