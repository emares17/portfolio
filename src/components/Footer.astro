---
import type { SiteConfig } from "@types";

type Props = Pick<SiteConfig, "author" | "socialLinks" | "email" | "brandName">;

const { socialLinks, email, brandName } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border px-10 py-8">
  <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
    <div class="flex items-center gap-2">
      <span class="font-mono text-base font-bold text-green">&gt;</span>
      <span class="font-mono text-[13px] font-medium text-text-primary">{brandName || "portfolio"}</span>
      <span class="font-mono text-xs text-text-tertiary">// {currentYear}</span>
    </div>

    <div class="flex items-center gap-6">
      {
        socialLinks.map(({ text, href }) => (
          <a
            href={href}
            target="_blank"
            class="font-mono text-xs font-medium text-text-secondary transition-colors hover:text-text-primary"
          >
            $ {text.toLowerCase()} &gt;&gt;
          </a>
        ))
      }
      {email && (
        <a
          href={`mailto:${email}`}
          class="font-mono text-xs font-medium text-text-secondary transition-colors hover:text-text-primary"
        >
          $ email &gt;&gt;
        </a>
      )}
    </div>
  </div>
</footer>
